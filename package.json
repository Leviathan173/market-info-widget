{
  "name": "market-info-widget",
  "version": "1.0.0",
  "private": true,
  "description": "金十快讯 + 指数/期货/贵金属 桌面悬浮窗",
  "main": "electron/main.js",
  "author": "maigo",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win",
    "dist:exe": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "resedit": "^3.1.0"
  },
  "dependencies": {
    "koffi": "^3.3.6"
  },
  "build": {
    "appId": "com.maigo.marketinfo",
    "productName": "MarketInfo",
    "copyright": "Copyright © 2026 maigo",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "build/afterPack.js",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "node_modules/koffi/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "MarketInfo-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "市场速览",
      "artifactName": "MarketInfo-${version}-setup.${ext}"
    }
  },
  "dependencies": {
    "koffi": "^3.3.6"
  }
}
